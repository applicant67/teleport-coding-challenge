[{"url":"https://api.github.com/repos/samschurter/teleport-challenge/issues/comments/903191134","html_url":"https://github.com/samschurter/teleport-challenge/pull/1#issuecomment-903191134","issue_url":"https://api.github.com/repos/samschurter/teleport-challenge/issues/1","id":903191134,"node_id":"IC_kwDOF7il0M411Zpe","user":{"login":"samschurter","id":7039470,"node_id":"MDQ6VXNlcjcwMzk0NzA=","avatar_url":"https://avatars.githubusercontent.com/u/7039470?v=4","gravatar_id":"","url":"https://api.github.com/users/samschurter","html_url":"https://github.com/samschurter","followers_url":"https://api.github.com/users/samschurter/followers","following_url":"https://api.github.com/users/samschurter/following{/other_user}","gists_url":"https://api.github.com/users/samschurter/gists{/gist_id}","starred_url":"https://api.github.com/users/samschurter/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/samschurter/subscriptions","organizations_url":"https://api.github.com/users/samschurter/orgs","repos_url":"https://api.github.com/users/samschurter/repos","events_url":"https://api.github.com/users/samschurter/events{/privacy}","received_events_url":"https://api.github.com/users/samschurter/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2021-08-22T00:04:26Z","updated_at":"2021-08-22T00:04:26Z","body":"> Please provide more details about who authentication will work and your authorization scheme.\r\n\r\nI will start by generating one main CA certificate. All the other certificates will be signed by that one.\r\n\r\nThen I will construct a TLSConfig with the CA certificate provided in the ClientCAs CertPool, MinVersion set to 1.3, and ClientAuth set to RequireAndVerifyClientCert. \r\nThen a server will be started with ListenAndServeTLS passing in the server certificate and secret key.  That will leave the Go server to validate and accept or reject the connection. \r\n\r\nIf the connection is accepted and the server believes the certificate from the client is valid, then all requests will pass through an authorization middleware. That will extract the tls.ConnectionState from the http.Request and check the Subject field of the first PeerCertificate. The Organization from the subject will be checked against a hardcoded list of usernames and routes. If the username is not allowed to access that route, then the request will be rejected. \r\n\r\nDoes that cover what you're looking for?","author_association":"OWNER","reactions":{"url":"https://api.github.com/repos/samschurter/teleport-challenge/issues/comments/903191134/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null},{"url":"https://api.github.com/repos/samschurter/teleport-challenge/issues/comments/908915962","html_url":"https://github.com/samschurter/teleport-challenge/pull/2#issuecomment-908915962","issue_url":"https://api.github.com/repos/samschurter/teleport-challenge/issues/2","id":908915962,"node_id":"IC_kwDOF7il0M42LPT6","user":{"login":"samschurter","id":7039470,"node_id":"MDQ6VXNlcjcwMzk0NzA=","avatar_url":"https://avatars.githubusercontent.com/u/7039470?v=4","gravatar_id":"","url":"https://api.github.com/users/samschurter","html_url":"https://github.com/samschurter","followers_url":"https://api.github.com/users/samschurter/followers","following_url":"https://api.github.com/users/samschurter/following{/other_user}","gists_url":"https://api.github.com/users/samschurter/gists{/gist_id}","starred_url":"https://api.github.com/users/samschurter/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/samschurter/subscriptions","organizations_url":"https://api.github.com/users/samschurter/orgs","repos_url":"https://api.github.com/users/samschurter/repos","events_url":"https://api.github.com/users/samschurter/events{/privacy}","received_events_url":"https://api.github.com/users/samschurter/received_events","type":"User","user