stract away communications with the gRPC server\r\n* Refactors the test that was using the direct gRPC client to use the new client abstraction\r\n* Replaces the quick-n-dirty CLI with a more robust version that also uses the client abstraction","closed_by":{"login":"adalton","id":751263,"node_id":"MDQ6VXNlcjc1MTI2Mw==","avatar_url":"https://avatars.githubusercontent.com/u/751263?v=4","gravatar_id":"","url":"https://api.github.com/users/adalton","html_url":"https://github.com/adalton","followers_url":"https://api.github.com/users/adalton/followers","following_url":"https://api.github.com/users/adalton/following{/other_user}","gists_url":"https://api.github.com/users/adalton/gists{/gist_id}","starred_url":"https://api.github.com/users/adalton/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/adalton/subscriptions","organizations_url":"https://api.github.com/users/adalton/orgs","repos_url":"https://api.github.com/users/adalton/repos","events_url":"https://api.github.com/users/adalton/events{/privacy}","received_events_url":"https://api.github.com/users/adalton/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/adalton/teleport-exercise/issues/3/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/adalton/teleport-exercise/issues/3/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/adalton/teleport-exercise/issues/2","repository_url":"https://api.github.com/repos/adalton/teleport-exercise","labels_url":"https://api.github.com/repos/adalton/teleport-exercise/issues/2/labels{/name}","comments_url":"https://api.github.com/repos/adalton/teleport-exercise/issues/2/comments","events_url":"https://api.github.com/repos/adalton/teleport-exercise/issues/2/events","html_url":"https://github.com/adalton/teleport-exercise/pull/2","id":10828