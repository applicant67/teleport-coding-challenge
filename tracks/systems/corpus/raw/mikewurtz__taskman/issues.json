tion.\r\n- Integration tests that call the gRPC server that test: \r\n  - Happy path tests for start, stop, stream, and get-status. These just check unimplemented for now\r\n  - Context's that have been cancelled\r\n  - Cert with no common name\r\n  - Cert that is self signed with no CA\r\n  - Cert that is weak (only uses a 512 bit key size)\r\n","closed_by":{"login":"mikewurtz","id":24414064,"node_id":"MDQ6VXNlcjI0NDE0MDY0","avatar_url":"https://avatars.githubusercontent.com/u/24414064?v=4","gravatar_id":"","url":"https://api.github.com/users/mikewurtz","html_url":"https://github.com/mikewurtz","followers_url":"https://api.github.com/users/mikewurtz/followers","following_url":"https://api.github.com/users/mikewurtz/following{/other_user}","gists_url":"https://api.github.com/users/mikewurtz/gists{/gist_id}","starred_url":"https://api.github.com/users/mikewurtz/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/mikewurtz/subscriptions","organizations_url":"https://api.github.com/users/mikewurtz/orgs","repos_url":"https://api.github.com/users/mikewurtz/repos","events_url":"https://api.github.com/users/mikewurtz/events{/privacy}","received_events_url":"https://api.github.com/users/mikewurtz/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/mikewurtz/taskman/issues/2/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/mikewurtz/taskman/issues/2/timeline","performed_via_github_app":null,"state_reason":null},{"url":"https://api.github.com/repos/mikewurtz/taskman/issues/1","repository_url":"https://api.github.com/repos/mikewurtz/taskman","labels_url":"https://api.github.com/repos/mikewurtz/taskman/issues/1/labels{/name}","comments_url":"https://api.github.com/repos/mikewurtz/taskman/issues/1/comments","events_url":"https://api.github.com/repos/mikewurtz/taskman/issues/1/events",