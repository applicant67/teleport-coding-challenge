/gist_id}","starred_url":"https://api.github.com/users/chintamanil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chintamanil/subscriptions","organizations_url":"https://api.github.com/users/chintamanil/orgs","repos_url":"https://api.github.com/users/chintamanil/repos","events_url":"https://api.github.com/users/chintamanil/events{/privacy}","received_events_url":"https://api.github.com/users/chintamanil/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":0,"created_at":"2026-02-23T05:23:48Z","updated_at":"2026-03-06T19:02:36Z","closed_at":"2026-03-06T19:02:36Z","assignee":{"login":"chintamanil","id":6878381,"node_id":"MDQ6VXNlcjY4NzgzODE=","avatar_url":"https://avatars.githubusercontent.com/u/6878381?v=4","gravatar_id":"","url":"https://api.github.com/users/chintamanil","html_url":"https://github.com/chintamanil","followers_url":"https://api.github.com/users/chintamanil/followers","following_url":"https://api.github.com/users/chintamanil/following{/other_user}","gists_url":"https://api.github.com/users/chintamanil/gists{/gist_id}","starred_url":"https://api.github.com/users/chintamanil/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/chintamanil/subscriptions","organizations_url":"https://api.github.com/users/chintamanil/orgs","repos_url":"https://api.github.com/users/chintamanil/repos","events_url":"https://api.github.com/users/chintamanil/events{/privacy}","received_events_url":"https://api.github.com/users/chintamanil/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"OWNER","active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/chintamanil/job-worker/pulls/5","html_url":"https://github.com/chintamanil/job-worker/pull/5","diff_url":"https://github.com/chintamanil/job-worker/pull/5.diff","patch_url":"https://github.com/chintamanil/job-worker/pull/5.patch","merged_at":null},"body":"## Summary\r\n\r\n- Add `Job.Start()` and `Job.Stop()` methods for process lifecycle management with cgroup v2 integration\r\n- Embed `JobState` struct in `Job` for cleaner state management with atomic multi-field reads via `State()` method\r\n- Define sentinel errors (`ErrJobNotFound`, `ErrJobAlreadyStarted`, etc.) for proper error handling\r\n- Use `UseCgroupFD` for atomic cgroup assignment at fork time\r\n- Spawn background `wait()` goroutine that handles process completion and cleanup\r\n\r\n ## Concurrency Fixes                                                                                                                                                                     \r\n                                                                                                                                                                                           \r\n  ### MemoryBuffer Race Conditions (Fixed)                                                                                                                                                 \r\n                                                                                                                                                                                           \r\n - Lost Wakeup Bug                                                                                                                                           \r\n     - `Reader.Close()` could call `Broadcast()` before `Read()` entered `Wait()`, causing goroutine leaks                                                                                    \r\n     - Fix: New `waitForData()` checks stop condition inside lock before waiting                                                                                                              \r\n                                                                                                                                                                                           \r\n  - Data Race on Reader.offset                                                                                                                                     \r\n     - `r.offset` was modified without mutex protection                                                                                                                                       \r\n     - Fix: All offset access now protected by `r.mu`  \r\n   \r\n  - Thundering Herd                                                                                                                                              \r\n     - `sync.Cond.Broadcast()` woke ALL readers on every write, causing mutex contention                                                                                                      \r\n     - Fix: Per-reader notification channels - each reader waits on its own channel, no contention on wake  \r\n    \r\n  - Lock Contention During Notification                                                                                                                                             \r\n     - Lock was held while iterating and sending to all reader channels (~1ms for 1000 readers)                                                                                               \r\n     - Fix: Copy channel list under lock, release lock, then send notifications                                                                                                               \r\n      - Result: Lock hold time reduced from ~1ms to ~50μs  \r\n   \r\n  ### Implementation                                                                                                                                                                       \r\n  - Replaced `sync.Cond` with `map[*MemoryBufferReader]chan struct{}`                                                                                                                      \r\n  - Each reader registers/unregisters its notification channel                                                                                                                             \r\n  - `Write()` and `Close()` release lock before sending notifications                                                                                                                      \r\n  - Clean context cancellation via `select` on `notify` + `ctx.Done()`                                                                                                                                        \r\n                                                                                                                                                                                                                                                                                                                                                                                                                                                       \r\n  ## Test Plan                                                                                                                                                             \r\n                                                                                                                                                                                           \r\n  - [x] Run `go test -v -race ./pkg/worker/...` - all 50 tests pass                                                                                                                        \r\n  - [x] Run `go test -v -race -count=100 ./pkg/worker/...` - no flaky races                                                                                                                \r\n  - [ ] Verify cgroup cleanup after job completion                                                                                                                                         \r\n  - [ ] Test job stop with `cgroup.kill` file    ","closed_by":{"login":"chintamanil","